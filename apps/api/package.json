{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": ".venv/bin/uvicorn app.main:app --reload --app-dir src --host 0.0.0.0 --port 8000",
    "lint": ".venv/bin/ruff check src tests",
    "type-check": ".venv/bin/mypy src",
    "test": ".venv/bin/pytest",
    "clean": "rm -rf .venv .pytest_cache .mypy_cache .ruff_cache"
  }
}
